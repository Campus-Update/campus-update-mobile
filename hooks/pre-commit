#!/bin/sh
#
# Runs the same checks CI runs, before the commit is created.
# Enable once per clone:  git config core.hooksPath hooks
# Skip in an emergency:   git commit --no-verify

set -e

fail() {
  echo ""
  echo "✗ Commit blocked: $1"
  echo "  $2"
  echo ""
  echo "  To commit anyway: git commit --no-verify"
  exit 1
}

echo "→ dart format"
if ! dart format --output=none --set-exit-if-changed . ; then
  fail "formatting" "Run 'dart format .' and stage the changes."
fi

echo "→ flutter analyze"
if ! flutter analyze ; then
  fail "analyzer" "Fix the errors listed above."
fi

echo "→ flutter test"
if ! flutter test ; then
  fail "tests" "Fix the failing tests listed above."
fi

echo ""
echo "✓ format, analyze and tests passed"
